---
// Unterseite pro Fallbeispiel. Wird nur gebaut, wenn im Kopfbereich landingpage: true steht.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const cases = await getCollection('fallbeispiele', ({ data }) => !data.draft && data.landingpage);
  return cases.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
const ogBild = d.coverBild ? d.coverBild.replace(/\/images\/case-(.+)\.webp$/, '/images/og-$1.jpg') : undefined;
// Strukturierte Daten: Artikel mit Autor, Datum und Bild (für Google und KI-Suchen)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.headline ?? d.title,
  description: d.beschreibung ?? d.teaser,
  inLanguage: 'de-DE',
  ...(d.date && { datePublished: d.date.toISOString().slice(0, 10) }),
  ...(d.coverBild && { image: new URL(d.coverBild, Astro.site).href }),
  ...(d.kategorie && { about: d.kategorie }),
  author: { '@type': 'Person', '@id': 'https://joshuametzele.de/#person', name: 'Joshua Metzele', url: 'https://joshuametzele.de/' },
  publisher: { '@id': 'https://joshuametzele.de/#person' },
  mainEntityOfPage: new URL(`/fallbeispiele/${c.id}/`, Astro.site).href,
};
const fmt = (x) => x.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.seoTitel ?? `${d.headline ?? d.title} · Joshua Metzele`} description={d.beschreibung ?? d.teaser} type="article" image={ogBild} jsonLd={jsonLd}>
  <main class="page">
    <div class="wrap">
      <a class="back" href="/#praxis">← Aus der Praxis</a>
      <h1>{d.headline ?? d.title}</h1>
      {d.untertitel && <p class="untertitel">{d.untertitel}</p>}
      {d.date && <div class="eyebrow meta" style="color:var(--muted);margin-bottom:28px">{fmt(d.date)}</div>}
      {d.coverBild && (
        <img class="cover" src={d.coverBild} alt={d.coverAlt ?? ''} width="1600" height="900" />
      )}
      {d.zusammenfassung && (
        <div class="ergebnis-box">
          <div class="label">Das Ergebnis</div>
          <p>{d.zusammenfassung}</p>
          {d.kennzahlen && (
            <div class="kennzahlen">
              {d.kennzahlen.map((k) => (
                <div class="kennzahl"><div class="wert">{k.wert}</div><div class="text">{k.text}</div></div>
              ))}
            </div>
          )}
        </div>
      )}
      <article class="prose story"><Content /></article>
    </div>
  </main>
  <!-- Schwarzer Banner über die volle Breite, zentriert, ohne Bild -->
  <section class="cta cta-center">
    <div class="wrap">
      <h2 set:html={d.ctaTitel ?? 'Lass uns über dein <span class="hl">Projekt</span> sprechen.'} />
      {d.ctaText && <p>{d.ctaText}</p>}
      <a class="btn cta-btn" href="mailto:hallo@joshuametzele.de?subject=Projektanfrage">Kontakt aufnehmen →</a>
    </div>
  </section>
</Base>

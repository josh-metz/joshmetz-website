---
// Zertifikate: graues Band direkt unter dem Hero, als schmales Band ohne Überschrift. Nur die Badges, darunter Titel und „Certification · Aussteller“.
// Jedes Badge öffnet den offiziellen Nachweis. Pflege der Liste: src/data/zertifikate.mjs
import { ZERTIFIKATE } from '../data/zertifikate.mjs';

const liste = [...ZERTIFIKATE].sort((a, b) => b.datum.localeCompare(a.datum));
---
<section id="zertifikate" class="certs" aria-label="Zertifizierungen">
  <div class="wrap">
    <ul class="certs-list">
      {liste.map((z) => (
        <li class="cert">
          <a href={z.link} target="_blank" rel="noopener">
            <img src={z.bild} alt={`Badge ${z.titel}, ${z.aussteller}`} height="96" loading="lazy" decoding="async" />
            <span class="cert-title">{z.titel}</span>
            <span class="cert-meta"><span class="nowrap">Certification ·</span> <span class="nowrap">{z.aussteller}</span><span class="sr-only"> (offizieller Nachweis, öffnet in neuem Tab)</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
